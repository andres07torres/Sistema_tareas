# =====================================================================
# CONFIGURACIÓN DEL SISTEMA DE TAREAS Y BOT
# =====================================================================

# ---------------------------------------------------------------------
# Base de Datos PostgreSQL (Docker)
# Puerto externo 5434 (5433 ocupado por portafolio_db)
# ---------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=tareas_db
DB_DATABASE=tareas_db
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena_segura
DB_EXTERNAL_PORT=5434

# ---------------------------------------------------------------------
# Gestor de Base de Datos pgAdmin 4 (Web)
# Puerto externo 5052 (5050 ocupado por phpmyadmin, 5051 por portafolio_pgadmin)
# ---------------------------------------------------------------------
PGADMIN_PORT=5052
PGADMIN_DEFAULT_EMAIL=admin@andr3sdev7.com
PGADMIN_DEFAULT_PASSWORD=Admin123456!

# ---------------------------------------------------------------------
# Puerto de la Aplicación Web (Host local en servidor)
# Puerto externo 8085 (8080 ocupado por nextcloud-app)
# ---------------------------------------------------------------------
APP_PORT=8085
APACHE_DOCUMENT_ROOT=/var/www/html/public
APP_URL=https://tareas.andr3sdev7.com

# ---------------------------------------------------------------------
# Seguridad y Notificaciones (Cron Webhook)
# ---------------------------------------------------------------------
CRON_TOKEN=ClaveSecretaParaCron123

# ---------------------------------------------------------------------
# Acceso al Panel de Administración (Dashboard de Actividades)
# ---------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD="TuPasswordSeguro@"
ADMIN_PASSWORD_HASH='$2y$10$LKOZqD4WE34PXQnjxYBdsOo8r7BpW/6QDzHOs.Fwsp7aP1Ei67j7i'

# ---------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------
TELEGRAM_TOKEN=tu_token_de_telegram_bot
TELEGRAM_CHAT_ID=tu_chat_id_de_telegram

# ---------------------------------------------------------------------
# Google API Credentials (Drive / OAuth)
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
